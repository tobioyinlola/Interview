# Rendered at container start by the nginx image's envsubst (see Dockerfile). Variables:
#   API_ORIGIN     the API's https origin, e.g. https://api.example.com
#   API_WS_ORIGIN  the same host as a WebSocket origin, e.g. wss://api.example.com
server {
  listen 8080;  # unprivileged image: no root, no port below 1024
  root /usr/share/nginx/html;
  index index.html;

  # Security headers on every response, including errors.
  add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; style-src-attr 'unsafe-inline'; img-src 'self' data:; font-src 'self'; media-src 'self'; worker-src 'self'; connect-src 'self' ${API_ORIGIN} ${API_WS_ORIGIN}; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'" always;
  add_header X-Content-Type-Options "nosniff" always;
  add_header Referrer-Policy "no-referrer" always;
  add_header X-Frame-Options "DENY" always;
  add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
  # Tab capture and the microphone are the only powerful features the app uses.
  add_header Permissions-Policy "display-capture=(self), microphone=(self), camera=(), geolocation=(), payment=()" always;

  # Built files carry a content hash in their name, so they can be cached for good.
  location /assets/ {
    add_header Cache-Control "public, max-age=31536000, immutable" always;
    add_header Content-Security-Policy "default-src 'none'" always;
    add_header X-Content-Type-Options "nosniff" always;
    try_files $uri =404;
  }

  # Single-page app: unknown paths serve index.html, which must never be cached.
  location / {
    add_header Cache-Control "no-cache" always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; style-src-attr 'unsafe-inline'; img-src 'self' data:; font-src 'self'; media-src 'self'; worker-src 'self'; connect-src 'self' ${API_ORIGIN} ${API_WS_ORIGIN}; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header X-Frame-Options "DENY" always;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header Permissions-Policy "display-capture=(self), microphone=(self), camera=(), geolocation=(), payment=()" always;
    try_files $uri /index.html;
  }
}
