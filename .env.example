# Copy to .env. Never commit real values. Server-side only; the browser build sees VITE_API_BASE_URL alone.
ENVIRONMENT=local
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/meetpractice
WEB_ORIGIN=http://localhost:5173
COOKIE_SECRET=change-me
OPENAI_API_KEY=
OPENAI_ANSWER_MODEL=gpt-4.1-mini
OPENAI_STT_MODEL=gpt-4o-transcribe
OPENAI_RESEARCH_MODEL=gpt-4.1-mini
CAP_STT_SECONDS_DAILY=5400
CAP_TOKENS_DAILY=500000
CAP_RESEARCH_JOBS_DAILY=10
