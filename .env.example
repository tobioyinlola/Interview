# Copy to .env. Never commit real values. Server-side only; the browser build sees VITE_API_BASE_URL alone.
ENVIRONMENT=local
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/meetpractice
WEB_ORIGIN=http://localhost:5173
COOKIE_SECRET=change-me
OPENAI_API_KEY=
OPENAI_ANSWER_MODEL=gpt-4.1-mini
OPENAI_STT_MODEL=gpt-4o-transcribe
OPENAI_RESEARCH_MODEL=gpt-4.1-mini
CAP_STT_SECONDS_DAILY=5400
CAP_TOKENS_DAILY=500000
CAP_RESEARCH_JOBS_DAILY=10

# Sign-in email (Resend). Needed outside local development; locally the link is printed in the API log.
RESEND_API_KEY=
EMAIL_FROM=
# Continue with Google. Leave empty and the button is hidden. Create a Web OAuth client in Google Cloud and
# add this redirect URI to it: API_PUBLIC_URL + /api/auth/google/callback  (locally:
# http://localhost:8000/api/auth/google/callback). Then restart the API.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
API_PUBLIC_URL=http://localhost:8000
