{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "InterviewMeet",
  "version": "0.1.0",
  "identifier": "com.interviewmeet.desktop",
  "build": { "frontendDist": "../app-dist" },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "dmg", "deb"],
    "icon": ["icons/icon.png"],
    "windows": { "nsis": { "installMode": "currentUser" } }
  },
  "plugins": {
    "deep-link": { "desktop": { "schemes": ["interviewmeet"] } }
  }
}
